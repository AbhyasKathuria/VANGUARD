# VANGUARD Environment Configuration Template
# All external services feature-flag and degrade gracefully to safe offline/mock modes when keys are absent.

# 1. Database & Authentication (System of Record)
DATABASE_URL="file:./dev.db"
JWT_SECRET="vanguard_rural_routing_secret_key_2026_super_secure"

# 2. SMS / OTP Verification (Optional - defaults to mock provider with test code: 123456)
OTP_PROVIDER="mock" # "mock" | "twilio" | "msg91"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# 3. WhatsApp Business Cloud API & Webhook (Optional - in-browser simulator active by default)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN="vanguard_webhook_verify_secret_2026"

# 4. Push Notifications & Firebase Storage (Optional - falls back to in-app audit timeline & base64)
FIREBASE_SERVER_KEY=
FCM_SERVER_KEY=
FIREBASE_AUTH_TOKEN=
FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# 5. Groq AI Keys (Multi-Key Rotation Pool for VanguardBot FAQ assistant)
GROQ_API_KEYS=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
